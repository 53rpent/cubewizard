# =============================================================================

# COPY THIS FILE TO `.dev.vars` AND FILL EVERY KEY YOU NEED (values may stay

# empty until you exercise that code path). Wrangler loads `.dev.vars` for any

# `wrangler dev` run in this repo (site worker, eval consumer, hedron consumer).

# =============================================================================



# --- Vision LLM (eval orient + extract) ---

# Model id sent in Chat Completions `model` (must match the gateway provider route).

EVAL_VISION_MODEL=gpt-5-mini-2025-08-07

# Provider API key (Bearer); forwarded by AI Gateway to the upstream provider.

EVAL_VISION_API_KEY=

EVAL_GATEWAY_PROVIDER=anthropic

# Optional — bypass gateway (direct OpenAI):

# EVAL_VISION_BASE_URL=https://api.openai.com/v1

# AI Gateway upstream timeout per request (ms); sets cf-aig-request-timeout (default 300000)

OPENAI_REQUEST_TIMEOUT_MS=300000

# Optional — OpenAI eval consumer log level: off | low | medium | high

CW_EVAL_LOG_LEVEL=


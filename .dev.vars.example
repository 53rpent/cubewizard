# =============================================================================
# COPY THIS FILE TO `.dev.vars` AND FILL EVERY KEY YOU NEED (values may stay
# empty until you exercise that code path). Wrangler loads `.dev.vars` for any
# `wrangler dev` run in this repo (site worker, eval consumer, hedron consumer).
# =============================================================================

# FILL — required locally (Wrangler loads this as the OPENAI_API_KEY secret).
OPENAI_API_KEY=

# Optional — OpenAI eval consumer log level: off | low | medium | high
CW_EVAL_LOG_LEVEL=

# Optional — log eval_memory lines (buffer MB estimates + Node heap when available): 1 | true | yes
# CW_EVAL_MEMORY_LOG=1   # heap_used_mb / rss_mb on each eval_consumer log line

# Optional — golden eval USD/1M tokens (skips bundled pricing CSV when both set)
# GOLDEN_EVAL_USD_PER_1M_INPUT=
# GOLDEN_EVAL_USD_PER_1M_OUTPUT=

# Optional — max vision/orient side in px (unset = full source resolution)
# CW_EVAL_MAX_IMAGE_SIDE=3072